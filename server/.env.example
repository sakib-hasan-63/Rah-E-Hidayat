# ==========================================
# Rah-e-Hidayat Server — Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (or local MongoDB for development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rah-e-hidayat?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Client URL (for CORS and password reset link in emails)
CLIENT_URL=https://rah-e-hidayat.vercel.app

# Admin Account Seed (used to create or verify admin on startup)
ADMIN_EMAIL=rah.e.hidayat1265@gmail.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin

# Optional SMTP Settings for Nodemailer
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=rah.e.hidayat1265@gmail.com
# EMAIL_PASS=your_app_password_here
