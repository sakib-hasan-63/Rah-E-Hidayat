# =================================================================
# Rah-e-Hidayat Server — Environment Variables Template
# =================================================================
# Copy to server/.env for local development. Never commit real values.

PORT=5000
NODE_ENV=production

# MongoDB connection string:
# Local Development: mongodb://localhost:27017/rah-e-hidayat
# Vercel Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rah-e-hidayat?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret & Expiration (Required for login & registration tokens)
JWT_SECRET=rah-e-hidayat-super-secret-jwt-key-2026
JWT_EXPIRE=30d

# Frontend Client URL (for CORS and reset-password email links)
CLIENT_URL=http://localhost:5173

# Admin Account Seed (initial admin provisioned on startup)
ADMIN_EMAIL=rah.e.hidayat1265@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional SMTP Settings (for transactional password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=
# SMTP_PASSWORD=
# FROM_NAME="Rah-e-Hidayat"
# FROM_EMAIL=
