# ==========================================
# Rah-e-Hidayat — Environment Configuration
# ==========================================
# Copy this file to .env for local development.
# In Vercel, add these keys under Project Settings -> Environment Variables.

# --- SERVER & GENERAL ---
PORT=5000
NODE_ENV=production

# --- MONGODB DATABASE ---
# Local: mongodb://localhost:27017/rah-e-hidayat
# Production: MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rah-e-hidayat?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rah-e-hidayat?retryWrites=true&w=majority

# --- AUTHENTICATION (JWT) ---
# Generate a strong secret key (e.g. using `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# --- CLIENT URL (CORS & Reset Password Links) ---
# Set to your Vercel deployment URL in production (e.g. https://your-project.vercel.app)
CLIENT_URL=https://rah-e-hidayat.vercel.app

# --- ADMIN SEED ACCOUNT ---
# Admin account automatically configured on initial startup
ADMIN_EMAIL=rah.e.hidayat1265@gmail.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin

# --- OPTIONAL: FRONTEND API URL ---
# Leave blank/omitted when deploying fullstack to Vercel (uses relative same-origin /api)
# Set only if backend is deployed to an external service (e.g. Render/Railway)
# VITE_API_URL=https://your-api-domain.com

# --- OPTIONAL: SMTP EMAIL CONFIGURATION (Password Reset Emails) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=rah.e.hidayat1265@gmail.com
# EMAIL_PASS=your_app_password_here
