# =================================================================
# Rah-e-Hidayat — Environment Configuration Template
# =================================================================
# Copy this file to .env for local development.
# Do NOT commit your actual .env file or real secrets to Git.
#
# For production (Vercel):
# Add these variables under: Project Settings -> Environment Variables.
# =================================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production

# --- MONGODB DATABASE ---
# Local Development: mongodb://localhost:27017/rah-e-hidayat
# Production (MongoDB Atlas): mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority
MONGODB_URI=

# --- AUTHENTICATION (JWT) ---
# Generate a strong, unique secret key (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRE=30d

# --- CLIENT / APPLICATION URL ---
# Local: http://localhost:5173
# Production (Vercel): https://your-project-name.vercel.app
CLIENT_URL=http://localhost:5173

# --- INITIAL ADMIN ACCOUNT ---
# Used to seed or verify the administrator account on initial startup
ADMIN_EMAIL=rah.e.hidayat1265@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- OPTIONAL: FRONTEND API URL ---
# Leave blank when deploying as a fullstack app on Vercel (uses same-origin /api).
# Set only if your backend API is hosted on a separate external server.
VITE_API_URL=

# --- OPTIONAL: SMTP EMAIL CONFIGURATION (Password Reset Service) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_email_app_password
# FROM_NAME="Rah-e-Hidayat"
# FROM_EMAIL=your_email@gmail.com
